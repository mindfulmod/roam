{
  "name": "tandem-roads",
  "version": "2.0.0",
  "private": true,
  "description": "Tandem Roads: city guides, food and dietary filters, maps and a multi-city trip planner.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "dev": "node scripts/build.mjs && npx --yes serve@14 dist",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/lint.mjs && node scripts/build.mjs && node --test \"tests/*.test.mjs\"",
    "test:db": "./scripts/db-test.sh",
    "format": "prettier --write src scripts data/cities data/*.json"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "playwright": "^1.63.0",
    "prettier": "3.6.2"
  }
}
